{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plas-hafod-cottage",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SANITY_PROJECT_ID": "iji5mij0",
    "NEXT_PUBLIC_SANITY_DATASET": "production",
    "RESEND_FROM_EMAIL": "Plas Hafod Cottage <info@plashafodcottage.co.uk>",
    "NOTIFICATION_EMAIL": "bob@clic.cymru",
    "PUBLIC_REPLY_EMAIL": "info@plashafodcottage.co.uk",
    "CRON_SECRET": "plas-hafod-cron-2026"
  },
  "triggers": {
    "crons": ["0 9 * * *"]
  }
}